[global]
frame_color = "#181825"
separator_color= frame
font = Inconsolata-medium 10
height = (50, 100)
width = (300, 300)
icon_position = left
max_icon_size = 30
min_icon_size = 50
transparency = 50
corner_radius = 10 
icon_corner_radius = 10
origin = top-right
notification_limit = 5
monitor = 1
timeout = 5

[urgency_low]
background = "#1E1E2E"
foreground = "#CDD6F4"

[urgency_normal]
background = "#1E1E2E"
foreground = "#CDD6F4"
frame_color = "#cba6f7"

[urgency_critical]
background = "#1E1E2E"
foreground = "#CDD6F4"
frame_color = "#FAB387"


