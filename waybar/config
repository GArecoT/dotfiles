{
  "layer": "top",
  "output": [
    "HDMI-A-1",
    "HDMI"
  ],
  "position": "left",
  "margin-top": 0,
  "margin-right": 0,
  "margin-left": 0,
  "modules-right": [],
  "modules-center": [
    "niri/workspaces",
    "tray",
    "network",
    "temperature",
    "pulseaudio",
    "mpris",
    "battery",
    "clock"
  ],
  "modules-left": [],
  "niri/workspaces": {
    "disable-scroll": true,
    "on-click": "activate",
    "format": "{icon}",
    "format-icons": {
      "default": "",
      "active": ""
    }
  },
  "tray": {
    "icon-size": 13,
    "spacing": 10
  },
  "custom/date": {
    "format": "{}",
    "interval": 3600,
    "exec": "$HOME/.config/waybar/waybar-date.sh"
  },
  "clock": {
    "justify": "center",
    "format": "{:%I\n%M\n<span>󰫢</span><span color='#ee99a0'>\n%d\n%m</span>}",
    "tooltip-format": "<big>{:%d %B %Y}</big>\n<tt><small>{calendar}</small></tt>",
    "calendar": {
      "format": {
        "months": "<span/>",
        "today": "<span color='#ee99a0'><b>{}</b></span>"
      }
    },
  },
  "network": {
    "justify": "center",
    "format-wifi": " ",
    "format-ethernet": "",
    "format-linked": "",
    "format-disconnected": "",
    "tooltip-format-wifi": "{essid} | Signal Strenght: {signalStrength}% | Down Speed: {bandwidthDownBits}, Up Speed: {bandwidthUpBits}",
    "on-click": "gnome-control-center"
  },
  "custom/updates": {
    "interval": 120,
    "return-type": "string",
    "exec": "~/.config/waybar/modules/updates.sh",
    "tooltip": false,
    "on-click": "setsid -f wezterm start paru -Syyu"
    //"on-click":"setsid -f foot -e paru -Syyu"  
  },
  "pulseaudio": {
    "justify": "center",
    "format": "{icon}\n{volume}",
    "format-muted": "",
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "scroll-step": 2,
    "format-icons": {
      "default": [
        "",
        "",
        ""
      ]
    },
    "on-click-right": "pavucontrol"
  },
  "temperature": {
    "justify": "center",
    "thermal-zone": 2,
    "hwmon-path": "/sys/class/hwmon/hwmon0/temp1_input",
    "critical-threshold": 80,
    "format-critical": "<span color='#f38ba8'>\n{temperatureC}</span>",
    "format": "\n{temperatureC}",
    "interval": 1
  },
  "niri/window": {
    "max-length": 60,
    "format": " {title} ",
    "rewrite": {
      "  ": " niri ~ Desktop "
    }
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "justify": "center",
    "format": "{icon}\n{capacity}%",
    "format-charging": "🗲",
    "format-plugged": "🗲",
    "format-alt": "{icon}",
    "format-full": "█",
    "format-icons": [
      "",
      "",
      "",
      ""
    ],
    "tooltip-format": " {capacity}%"
  },
  "mpris": {
    "format": "{player_icon}",
    "format-paused": "{status_icon}",
    "tooltip-format": "{player}: {title}\n{dynamic}",
    "player-icons": {
      "default": "",
    },
    "status-icons": {
      "paused": ""
    },
    "on-click-right": "playerctld shift",
  }
}
